# Tiger Brokers Open API
# Get these from https://quant.itigerop.com → My Apps → create an app
TIGER_ID=your_tiger_numeric_id
# Paste your RSA private key as a single line with \n replacing real newlines:
# e.g. -----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----
TIGER_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
